{
  "name": "orbi-te-studio",
  "version": "0.1.0",
  "private": true,
  "description": "ORBI TE Studio - asistencia para diseño, verificación y preparación de proyectos TE1/TE4 en Chile",
  "type": "module",
  "scripts": {
