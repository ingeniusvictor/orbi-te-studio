# ORBI TE Studio local AI
# Default stays deterministic/mock until qwen-local is explicitly selected.
ORBI_AI_PROVIDER=mock

# Enable text Qwen through local Ollama:
# ORBI_AI_PROVIDER=qwen-local
ORBI_QWEN_BASE_URL=http://127.0.0.1:11434
ORBI_QWEN_MODEL=qwen3:8b

# Persistent local server ledger
# ORBI_AUDIT_LEDGER_PATH=.orbi-data/server-audit-ledger.json

# Planned observation-only visual provider:
# ORBI_QWEN_VISION_MODEL=qwen2.5vl:3b
